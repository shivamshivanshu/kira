# The column-rendering path for schema-declared fields, which
# schema-custom-fields.txtar does not touch: ui.list.columns naming a declared
# field, how set/list/absent values render in a cell, and what an undeclared
# name does. Field writing and --json typing are covered there, not here.
env GIT_CONFIG_GLOBAL=/dev/null
env GIT_CONFIG_SYSTEM=/dev/null
env EDITOR=true
exec git init
exec git config user.email test@example.com
exec git config user.name tester
exec kira init --key KIRA
cp ticket.json .kira/schema/ticket.json
exec kira create ticket --title 'Alpha' --no-edit --field severity=HIGH --field watchers=alice,bob
exec kira create ticket --title 'Beta' --no-edit

# ui.list.columns may name a schema-declared field: a scalar renders its value,
# a list comma-joins, and an item that has not set one renders -.
cp columns-config.yaml .kira/config.yaml
exec kira list --no-color
stdout 'NUMBER\s+TITLE\s+SEVERITY\s+WATCHERS'
stdout 'KIRA-1\s+Alpha\s+HIGH\s+alice, bob'
stdout 'KIRA-2\s+Beta\s+-\s+-'

# a name neither a built-in cell nor declared by any schema warns and is
# dropped from the table: config cannot see schemas, so the check lives at
# render time where they are loaded.
cp typo-config.yaml .kira/config.yaml
exec kira list --no-color
stderr 'ui.list.columns: unknown column "severty"; ignored'
! stdout 'SEVERTY'
stdout 'NUMBER\s+TITLE'

-- ticket.json --
{
  "name": "ticket",
  "workflow": "ticket",
  "fields": [
    { "name": "title", "type": "string", "required": true },
    { "name": "state", "type": "state", "required": true, "system": true, "guarded": true,
      "states": [
        { "key": "TODO", "category": "todo" },
        { "key": "IN_PROGRESS", "category": "doing" },
        { "key": "REVIEW", "category": "doing" },
        { "key": "DONE", "category": "done" },
        { "key": "WONT_DO", "category": "done" }
      ] },
    { "name": "subtype", "type": "enum", "enum": "subtype", "source": "subtypes" },
    { "name": "priority", "type": "enum", "enum": "priority", "source": "priorities" },
    { "name": "resolution", "type": "resolution", "enum": "resolution", "source": "resolutions" },
    { "name": "rank", "type": "string" },
    { "name": "owner", "type": "ref", "target": "person", "source": "people" },
    { "name": "reporter", "type": "ref", "target": "person", "source": "people" },
    { "name": "labels", "type": "enum", "enum": "label", "source": "labels", "list": true, "unique": true },
    { "name": "parent", "type": "ref", "target": "epic" },
    { "name": "blocked_by", "type": "ref", "target": "ticket", "list": true, "unique": true },
    { "name": "sprint", "type": "ref", "target": "sprint", "source": "sprints" },
    { "name": "due", "type": "date" },
    { "name": "estimate", "type": "number" },
    { "name": "aliases", "type": "string", "list": true, "unique": true, "required": true, "system": true },
    { "name": "created", "type": "datetime", "required": true, "system": true, "immutable": true },
    { "name": "updated", "type": "datetime", "required": true, "system": true },
    { "name": "description", "type": "markdown", "placement": "body", "section": "Description" },
    { "name": "acceptance", "type": "markdown", "placement": "body", "section": "Acceptance criteria" },
    { "name": "severity", "type": "string" },
    { "name": "watchers", "type": "string", "list": true }
  ]
}
-- columns-config.yaml --
version: 1
project:
  key: KIRA
ui:
  list:
    columns: [number, title, severity, watchers]
-- typo-config.yaml --
version: 1
project:
  key: KIRA
ui:
  list:
    columns: [number, title, severty]
