# link sets single-sided parent/blocked-by edges and rejects illegal links.
env GIT_CONFIG_GLOBAL=/dev/null
env GIT_CONFIG_SYSTEM=/dev/null
env EDITOR=true
exec git init
exec git config user.email test@example.com
exec git config user.name tester
exec kira init --key KIRA
exec kira create ticket --title 'A' --no-edit
exec kira create ticket --title 'B' --no-edit
exec kira create epic --title 'E' --no-edit

# blocked-by is stored on the dependent (KIRA-1) only
exec kira link KIRA-1 --blocked-by KIRA-2
exec git log --oneline
stdout 'kira: KIRA-1 link blocked-by KIRA-2'
exec kira show KIRA-1 --json
stdout '"blocked_by": \['
# the blocker's own file stores no inverse edge; blocks is derived from the set
exec kira show KIRA-2 --json
stdout '"blocks": \[\n    "[0-9A-Z]{26}"\n  \]'
! stdout '"blocked_by": \[\n'

# parent
exec kira link KIRA-1 --parent KIRA-3
exec kira show KIRA-1 --json
stdout '"parent": "[0-9A-Z]{26}"'

# self-link is rejected
! exec kira link KIRA-1 --blocked-by KIRA-1
stderr 'cannot link to itself'

# a parent must declare the container capability, so a ticket is refused
! exec kira link KIRA-3 --parent KIRA-1
stderr 'does not group other items'

# containers nest: an epic may be parented to another epic
exec kira create epic --title 'E2' --no-edit
exec kira link KIRA-3 --parent KIRA-4
exec kira show KIRA-3 --json
stdout '"parent": "[0-9A-Z]{26}"'
exec kira link KIRA-3 --parent KIRA-4 --remove

# giving both or neither edge flag is a usage error
! exec kira link KIRA-1
stderr 'exactly one'

# --remove clears the edge
exec kira link KIRA-1 --parent KIRA-3 --remove
exec kira show KIRA-1 --json
stdout '"parent": null'

# the removed --epic alias is an unknown flag
! exec kira link KIRA-1 --epic KIRA-3
stderr 'unknown flag: --epic'
