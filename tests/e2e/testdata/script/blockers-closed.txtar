# The blockers-closed guard gates every move into a done-category state on each
# blocked_by target being done itself: refuse by default, --force downgrades to
# a warning, and an undeterminable blocker degrades to warn+pass rather than
# bricking the move.
env GIT_CONFIG_GLOBAL=/dev/null
env GIT_CONFIG_SYSTEM=/dev/null
env EDITOR=true
exec git init
exec git config user.email test@example.com
exec git config user.name tester
exec kira init --key KIRA
cp config.yaml .kira/config.yaml
exec git add -A
exec git commit -m 'a three-state ticket workflow'

exec kira create ticket --title 'A' --no-edit
exec kira create ticket --title 'B' --no-edit
exec kira create ticket --title 'C' --no-edit
exec kira link KIRA-1 --blocked-by KIRA-2

# a move to a state outside the done category is never gated
exec kira move KIRA-1 IN_PROGRESS

# an open blocker refuses a done-category move by default
! exec kira move KIRA-1 DONE
stderr 'blocked by open items'

# --force downgrades the guard to a warning and still moves
exec kira move KIRA-1 DONE --force
stderr 'forced past blocker guard'

# a blocker in a state the workflow no longer declares (no known state
# category) cannot be evaluated: warn and pass rather than brick the move on
# missing data. It stays type ticket (CORE-43 rejects a blocked_by target of
# the wrong entity type on write), just with a state config.yaml doesn't list.
cp legacy-state.md .kira/tickets/01HXAGA0000000000000000000.md
exec kira link KIRA-3 --blocked-by KIRA-77
exec kira move KIRA-3 DONE
stderr 'no known state category'

-- config.yaml --
version: 2
project:
  key: KIRA
  name: KIRA
boards:
  - { key: KIRA, name: KIRA, default: true }
workflows:
  ticket:
    states:
      - { key: TODO,        category: todo }
      - { key: IN_PROGRESS, category: doing }
      - { key: DONE,        category: done }
    initial: TODO

-- legacy-state.md --
---
id: 01HXAGA0000000000000000000
number: KIRA-77
aliases: []
type: ticket
title: a blocker stuck in a retired state
state: LEGACY
labels: []
blocked_by: []
epic: null
created: 2026-07-10T09:14:00+05:30
updated: 2026-07-10T09:14:00+05:30
---
## Description
