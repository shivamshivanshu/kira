# KIRA-79 boards: init writes one explicit default board; `board create` appends
# to the list; create honors --board and the default; old numbers keep
# resolving after a board is added.
env GIT_CONFIG_GLOBAL=/dev/null
env GIT_CONFIG_SYSTEM=/dev/null
env EDITOR=true
exec git init
exec git config user.email test@example.com
exec git config user.name tester
exec kira init --key KIRA

# a fresh repo is version 2 with the project's board as the default
grep '^version: 2$' .kira/config.yaml
grep '^  - \{ key: KIRA, name: .*, default: true \}$' .kira/config.yaml

# 1 board: create is silent and mints in the project key space
exec kira create ticket --title early --no-edit
stdout 'KIRA-1'

# board create appends to the list, committing a structured subject
exec kira board create XYZ --name Beta
stdout 'Created board XYZ'
grep 'key: KIRA' .kira/config.yaml
grep 'default: true' .kira/config.yaml
grep 'key: XYZ' .kira/config.yaml
exec git log --oneline
stdout 'board create XYZ'

# a number minted before the board was added still resolves afterward
exec kira show KIRA-1
stdout 'KIRA-1'

# --board mints in the named board's own numbering namespace
exec kira create ticket --title on-xyz --no-edit --board XYZ
stdout 'XYZ-1'

# with N boards and a default present, a bare create uses the default (KIRA)
exec kira create ticket --title on-default --no-edit
stdout 'KIRA-2'

# per-board numbering is independent: XYZ keeps its own sequence
exec kira create ticket --title on-xyz-2 --no-edit --board XYZ
stdout 'XYZ-2'
