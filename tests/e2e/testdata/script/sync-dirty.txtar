# a dirty .kira/ makes a bare sync refuse, even under commit.mode auto;
# --commit checkpoints it before pulling (the pull then fails: no upstream).
env GIT_CONFIG_GLOBAL=/dev/null
env GIT_CONFIG_SYSTEM=/dev/null
env EDITOR=true
env GIT_AUTHOR_NAME=tester
env GIT_AUTHOR_EMAIL=test@example.com
env GIT_COMMITTER_NAME=tester
env GIT_COMMITTER_EMAIL=test@example.com
exec git init --initial-branch=main
exec kira init --key KIRA
exec kira create ticket --title A --no-edit

# dirty a tracked kira file; the branch has no upstream.
cp dirtied.yaml .kira/config.yaml
exec git status --porcelain
stdout 'config.yaml'

! exec kira sync
stderr 'uncommitted kira changes; re-run with --commit'
exec git status --porcelain
stdout 'config.yaml'

! exec kira sync --commit
stderr 'prepare'
exec git log -1 --format=%s
stdout 'sync checkpoint'
exec git status --porcelain
! stdout 'config.yaml'

-- dirtied.yaml --
version: 2
project:
  key: KIRA
  name: kira
boards:
  - { key: KIRA, name: kira, default: true }
# locally modified to create a dirty tracked kira file
