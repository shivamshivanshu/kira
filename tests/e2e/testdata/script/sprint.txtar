# sprint create appends to config comment-preservingly and commits; list marks
# the active sprint and counts items; activate writes the git-ignored pointer;
# close reports spillover and --move-to reassigns it one commit per item
#.
env GIT_CONFIG_GLOBAL=/dev/null
env GIT_CONFIG_SYSTEM=/dev/null
env EDITOR=true
mkdir proj
cd proj
exec git init
exec git config user.email test@example.com
exec git config user.name tester
exec kira init --key KIRA

# create appends to the scaffolded empty list; the whole config, comments
# included, must match the golden byte for byte
exec kira sprint create --key 2026-S14 --name 'Sprint 14' --start 2026-07-13 --end 2026-07-26 --json
stdout '"created": true'
stdout '"key": "2026-S14"'
exec kira sprint create --key 2026-S15 --name 'Sprint 15' --start 2026-07-27 --end 2026-08-09
cmp .kira/config.yaml ../expected-config.yaml
exec git log --oneline
stdout 'sprint create 2026-S15'
stdout 'sprint create 2026-S14'

# duplicate keys and inverted windows are rejected
! exec kira sprint create --key 2026-S14 --name X --start 2026-01-01 --end 2026-01-02
stderr 'duplicate key'
! exec kira sprint create --key 2026-S16 --name X --start 2026-02-01 --end 2026-01-02
stderr 'not before end'

# list counts assigned items per sprint
exec kira create ticket --title 'T1' --no-edit --sprint 2026-S14 --estimate 3
exec kira create ticket --title 'T2' --no-edit --sprint 2026-S14 --estimate 5
exec kira sprint list --json
stdout '"key": "2026-S14"'
stdout '"total": 2'
stdout '"active": false'

# activate writes the git-ignored local pointer and reports the previous one
exec kira sprint activate 2026-S14 --json
stdout '"activated": "2026-S14"'
exists .kira/.cache/active-sprint
grep '2026-S14' .kira/.cache/active-sprint
exec kira sprint activate 2026-S15 --json
stdout '"previous": "2026-S14"'
exec kira sprint activate 2026-S14
! exec kira sprint activate 2099-S1
stderr 'not a key in the configured sprints'

# a done-category item is finished; the rest is spillover
exec kira move KIRA-1 WONT_DO --resolution dropped
exec kira sprint close 2026-S14 --json
stdout '"closed": "2026-S14"'
stdout '"KIRA-2"'
stdout '"was_active": true'
! stdout 'KIRA-1'
! stdout '"moved_to"'
! exists .kira/.cache/active-sprint

# --move-to reassigns each unfinished item through the audited edit pipeline
exec kira sprint activate 2026-S14
exec kira sprint close 2026-S14 --move-to 2026-S15 --json
stdout '"moved_to": "2026-S15"'
stdout '"was_active": true'
exec kira show KIRA-2 --json
stdout '"sprint": "2026-S15"'
exec git log --oneline
stdout 'KIRA-2 sprint 2026-S14 -> 2026-S15'
! exists .kira/.cache/active-sprint

# after the move nothing is left in the closed sprint
exec kira sprint list --json
stdout '"total": 1'

-- expected-config.yaml --
version: 2

project:
  key: KIRA
  name: proj

boards:
  - { key: KIRA, name: proj, default: true }

labels:
  known: []                   # add project labels; strict rejects unknown ones (--force overrides)
  # known: [bug, feature, perf, tech-debt, infra]   # example vocabulary
  strict: false

people:
  known: []                   # add known people; strict rejects unknown assignees
  # known: [{ name: jdoe }, { name: asmith }]        # example roster
  strict: false

commit:
  mode: auto                  # auto | manual

merge:
  policy: auto                # auto | manual: auto-resolve same-field kira conflicts vs leave markers

sync:
  push: false                 # true = kira sync publishes after a clean pull; default is pull-only

# workon: branch and worktree naming (built-in defaults shown; uncomment a key to pin it for this repo)
#   branch_pattern: "{key}/{number}-{slug}"   # tokens: {key} {number} {slug}

# ui: TUI and board appearance (personal presentation; prefer ~/.config/kira/config.yaml so pins are not shared across clones)
#   icons: auto               # auto | nerd | emoji | text
#   background: dark          # dark | light

estimate:
  unit: points                # points | hours

# --- optional blocks: uncomment and edit to enable (defaults shown are inert) ---

# filters: named saved queries, run via kira list --filter <name>.
filters:
  next: state = TODO AND NOT blocked ORDER BY priority

# sprints: sprint entities, created by kira sprint create; items key into this list.
#sprints:

# git: relate kira items to the commits and branches that touch them.
#   landed_ref — ref (e.g. origin/main) whose history marks work as merged/landed
#git: {}
sprints:
  - { key: 2026-S14, name: Sprint 14, start: "2026-07-13", end: "2026-07-26" }
  - { key: 2026-S15, name: Sprint 15, start: "2026-07-27", end: "2026-08-09" }
