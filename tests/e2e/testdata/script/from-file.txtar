# --print-template feeds --from-file: the nvim create round-trip without $EDITOR.
env GIT_CONFIG_GLOBAL=/dev/null
env GIT_CONFIG_SYSTEM=/dev/null
env EDITOR=true
exec git init
exec git config user.email test@example.com
exec git config user.name tester
exec kira init --key KIRA

# print-template mints nothing and writes nothing; it just emits the skeleton.
exec kira create ticket --print-template --title 'FF ticket' --owner alice
stdout 'title: FF ticket'
cp stdout draft.md

# no ticket was created by print-template
exec kira list --json
stdout '"count": 0'

# feeding the draft back creates the item
exec kira create ticket --from-file draft.md --json
stdout '"number": "KIRA-1"'
exec kira show KIRA-1 --json
stdout '"title": "FF ticket"'
stdout '"owner": "alice"'

# flags still apply alongside --from-file: the file supplies the values, an
# explicit flag overrides them
exec kira create epic --title 'Parent' --no-edit
exec kira create ticket --from-file draft.md --parent KIRA-2 --priority P1 --json
exec kira show KIRA-3 --json
stdout '"priority": "P1"'
stdout '"epic": "[0-9A-Z]{26}"'
stdout '"title": "FF ticket"'

# a value the file sets loses to the flag, and survives when no flag competes
cp with-priority.md p.md
exec kira create ticket --from-file p.md --priority P0
exec kira show KIRA-4 --json
stdout '"priority": "P0"'
exec kira create ticket --from-file p.md
exec kira show KIRA-5 --json
stdout '"priority": "P3"'

-- with-priority.md --
---
title: Has a priority
priority: P3
---

